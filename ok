            <!-- Desktop Nav Links -->
            <div class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-700">
                <a href="#loi-ngo" class="hover:text-amber-600 transition">Lời Ngỏ</a>
                <a href="#lich-su" class="hover:text-amber-600 transition">Dấu Ấn Lịch Sử</a>
                <a href="#thu-vien" class="hover:text-amber-600 transition">Thư Viện Ảnh</a>
                <a href="#minigame" class="hover:text-amber-600 transition">Vé Thanh Xuân</a>
                <a href="#so-luu-niem" class="hover:text-amber-600 transition">Sổ Lưu Niệm</a>
