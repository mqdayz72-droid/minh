</head>
<body class="bg-warmCream text-slate-800 font-sans antialiased selection:bg-rose-200 selection:text-slate-900">

    <!-- NAVIGATION BAR -->
    <nav class="fixed top-0 left-0 right-0 z-50 glass-card shadow-sm border-b border-rose-100/50">
