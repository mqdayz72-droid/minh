    <!-- JAVASCRIPT LOGIC -->
    <script>
        // MINIGAME QUIZ LOGIC
        const quizQuestionsData = [
            {
                q: "Trường THPT Minh Hà được thành lập vào năm nào?",
                opts: ["1956", "1966", "1976", "1986"],
                correct: 1,
                exp: "Trường được thành lập vào năm 1966 nhằm đáp ứng nhu cầu học tập của con em nhân dân vùng đảo Hà Nam, thị xã Quảng Yên."
            },
            {
                q: "Trường THPT Minh Hà vinh dự mang tên bí danh của vị anh hùng nào?",
                opts: ["Anh hùng Đỗ Thị Sinh", "Anh hùng Võ Thị Sáu", "Anh hùng Lý Tự Trọng", "Anh hùng Nguyễn Văn Trỗi"],
                correct: 0,
                exp: "Trường mang tên Anh hùng liệt sĩ Đỗ Thị Sinh (bí danh Minh Hà) - người cán bộ kiên trung anh dũng hy sinh tại vùng đất này."
            },
            {
                q: "Trường THPT Minh Hà hiện nay thuộc địa bàn nào của Quảng Ninh?",
                opts: ["TP. Hạ Long", "Xã Cẩm La, Thị xã Quảng Yên", "TP. Uông Bí", "Huyện Tiên Yên"],
                correct: 1,
                exp: "Trường tọa lạc khang trang tại Xã Cẩm La, Thị xã Quảng Yên, Tỉnh Quảng Ninh."
            },
            {
                q: "Năm 2026 đánh dấu mốc kỷ niệm bao nhiêu năm thành lập Trường THPT Minh Hà?",
                opts: ["40 năm", "50 năm", "60 năm", "70 năm"],
                correct: 2,
                exp: "Năm 2026 đánh dấu mốc son 60 năm lịch sử tự hào của nhà trường (1966 - 2026)."
            },
            {
                q: "Phương châm nổi bật nối tiếp truyền thống 60 năm của THPT Minh Hà là gì?",
                opts: ["Tự hào truyền thống - Vững bước tương lai", "Học đi đôi với hành", "Đoàn kết - Đổi mới - Sáng tạo", "Tất cả các ý trên đều đúng"],
                correct: 3,
                exp: "Tất cả các giá trị trên đều là nền tảng vững chắc làm nên sức mạnh của các thế hệ học sinh Minh Hà!"
            }
        ];

        const luckyWishes = [
            "Chúc bạn luôn giữ mãi ngọn lửa nhiệt huyết và gặt hái thật nhiều thành công!",
            "Dù đi đâu về đâu, THPT Minh Hà vẫn luôn là bến đỗ bình yên trong tim bạn.",
            "Chúc bạn luôn tỏa sáng rực rỡ như tinh thần tự hào của học sinh Minh Hà!",
            "Chúc bạn luôn giữ được nụ cười trong trẻo của tuổi học trò dưới mái trường mến yêu!"
        ];

        let currentQIndex = 0;
        let userScore = 0;
        let playerInfo = { name: '', classStr: '' };

        function startQuizGame() {
            const name = document.getElementById('quizUserName').value.trim();
            const classStr = document.getElementById('quizUserClass').value.trim();

            if (!name || !classStr) {
                alert('Vui lòng điền đầy đủ Họ tên và Lớp/Khóa để tiếp tục!');
                return;
            }

            playerInfo.name = name;
            playerInfo.classStr = classStr;

            document.getElementById('quizWelcome').classList.add('hidden');
            document.getElementById('quizQuestions').classList.remove('hidden');

            loadQuizQuestion();
        }

        function loadQuizQuestion() {
            const currentQ = quizQuestionsData[currentQIndex];
            document.getElementById('quizCounter').innerText = `Câu hỏi ${currentQIndex + 1} / ${quizQuestionsData.length}`;
            document.getElementById('quizScore').innerText = `Điểm: ${userScore}`;
            document.getElementById('quizQuestionText').innerText = currentQ.q;

            const optsBox = document.getElementById('quizOptions');
            optsBox.innerHTML = '';

            currentQ.opts.forEach((optText, i) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-3 rounded-xl border border-slate-200 hover:border-amber-400 hover:bg-amber-50/50 text-xs sm:text-sm text-slate-700 font-medium transition flex items-center justify-between";
                btn.onclick = () => handleQuizAnswer(i);
                btn.innerHTML = `<span>${optText}</span><i class="fa-regular fa-circle text-slate-300"></i>`;
                optsBox.appendChild(btn);
            });

            document.getElementById('quizExplanation').classList.add('hidden');
            document.getElementById('quizNextBtn').classList.add('hidden');
        }

        function handleQuizAnswer(selectedIdx) {
            const currentQ = quizQuestionsData[currentQIndex];
            const optsBox = document.getElementById('quizOptions');
            const btns = optsBox.getElementsByTagName('button');

            for (let i = 0; i < btns.length; i++) {
                btns[i].disabled = true;
                if (i === currentQ.correct) {
                    btns[i].className = "w-full text-left p-3 rounded-xl border border-emerald-500 bg-emerald-50 text-xs sm:text-sm text-emerald-800 font-bold transition flex items-center justify-between";
                } else if (i === selectedIdx) {
                    btns[i].className = "w-full text-left p-3 rounded-xl border border-rose-400 bg-rose-50 text-xs sm:text-sm text-rose-700 transition flex items-center justify-between";
                }
            }

            if (selectedIdx === currentQ.correct) {
                userScore += 20;
            }

            document.getElementById('quizExplanationText').innerText = currentQ.exp;
            document.getElementById('quizExplanation').classList.remove('hidden');
            document.getElementById('quizNextBtn').classList.remove('hidden');
        }

        function nextQuizQuestion() {
            currentQIndex++;
            if (currentQIndex < quizQuestionsData.length) {
                loadQuizQuestion();
            } else {
                finishQuizGame();
            }
        }

        function finishQuizGame() {
            document.getElementById('quizQuestions').classList.add('hidden');
            document.getElementById('quizResult').classList.remove('hidden');

            document.getElementById('ticketNameDisplay').innerText = playerInfo.name;
            document.getElementById('ticketClassDisplay').innerText = playerInfo.classStr;
            document.getElementById('ticketCode').innerText = `MH-${Math.floor(1000 + Math.random() * 9000)}`;

            const randomWish = luckyWishes[Math.floor(Math.random() * luckyWishes.length)];
            document.getElementById('ticketWishDisplay').innerText = `"${randomWish}"`;

            confetti({ particleCount: 80, spread: 60, origin: { y: 0.6 } });
        }

        function resetQuizGame() {
            currentQIndex = 0;
            userScore = 0;
            document.getElementById('quizResult').classList.add('hidden');
            document.getElementById('quizWelcome').classList.remove('hidden');
        }

        // GUESTBOOK FORM HANDLER
        function handleGuestbookSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('gbName').value.trim();
            const role = document.getElementById('gbRole').value.trim();
            const msg = document.getElementById('gbMessage').value.trim();

            if (!name || !role || !msg) return;

            const list = document.getElementById('guestbookList');
            const newCard = document.createElement('div');
            newCard.className = "glass-card p-5 rounded-2xl shadow-sm border border-slate-100 animate-fade-in";
            newCard.innerHTML = `
                <div class="flex justify-between items-start mb-2">
                    <div>
                        <h4 class="font-serif font-bold text-brandBlue text-sm">${name}</h4>
                        <span class="text-[10px] text-amber-600 font-semibold">${role}</span>
                    </div>
                    <span class="text-[10px] text-slate-400">Vừa xong</span>
                </div>
                <p class="text-slate-600 text-xs sm:text-sm italic leading-relaxed">"${msg}"</p>
            `;

            list.prepend(newCard);
            document.getElementById('guestbookForm').reset();
            alert('Cảm ơn bạn đã gửi lời nhắn tới Sổ lưu niệm Trường THPT Minh Hà!');
        }
    </script>
