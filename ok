    <!-- SECTION 1: LỜI NGỎ TỪ BAN GIÁM HIỆU -->
    <section id="loi-ngo" class="py-20 bg-gradient-to-b from-warmCream via-pastelRose/30 to-warmCream">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <div class="glass-card p-8 sm:p-12 rounded-3xl shadow-xl relative border border-rose-100/80">
                <!-- Quote icon -->
                <div class="absolute -top-6 left-1/2 -translate-x-1/2 w-12 h-12 bg-amber-300 text-brandBlue rounded-full flex items-center justify-center text-xl shadow-md">
                    <i class="fa-solid fa-quote-left"></i>
                </div>

                <div class="text-center space-y-3 mb-8 pt-2">
                    <span class="text-xs font-bold text-amber-600 uppercase tracking-widest">Thông Điệp Tri Ân</span>
                    <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brandBlue">Lời Ngỏ Từ Ban Giám Hiệu</h2>
                    <div class="w-16 h-0.5 bg-amber-400 mx-auto rounded-full"></div>
                </div>

                <div class="space-y-4 text-slate-700 text-sm sm:text-base leading-relaxed text-justify font-light">
                    <p>
                        <span class="font-bold text-brandBlue">Kính gửi các thế hệ Thầy Cô giáo, Cựu học sinh và các em học sinh THPT Minh Hà thân yêu!</span>
                    </p>
                    <p>
                        Sáu mươi năm - một chặng đường chưa dài so với lịch sử, nhưng đối với mái trường THPT Minh Hà (Quảng Ninh), đó là cả một hành trình tự hào dựng xây, trưởng thành và cống hiến. Từ những ngày đầu thành lập gian khó năm 1966 dưới mái tranh vách đát, thầy và trò nhà trường đã vượt qua muôn vàn thử thách để thắp sáng ngọn lửa tri thức.
                    </p>
                    <p>
                        Năm 2026 đánh dấu mốc son vàng 60 năm. Tập san điện tử này là món quà tri ân chân thành gửi tới những người đã và đang viết nên trang sử vẻ vang của nhà trường. Dù bạn ở đâu, làm gì, THPT Minh Hà vẫn luôn là ngôi nhà chung ấm áp dang tay đón bạn trở về.
                    </p>
                </div>

                <div class="mt-8 pt-6 border-t border-rose-100 flex items-center justify-between">
                    <div>
                        <h4 class="font-serif font-bold text-brandBlue text-base">BAN GIÁM HIỆU</h4>
                        <p class="text-xs text-slate-500">Trường THPT Minh Hà - Quảng Ninh</p>
                    </div>
                    <div class="font-handwriting text-3xl text-amber-600 font-bold">
                        Minh Hà 2026
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 2: DÒNG THỜI GIAN LỊCH SỬ (TIMELINE) -->
    <section id="lich-su" class="py-20 bg-pastelSky/40">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
            <div class="text-center max-w-2xl mx-auto mb-16 space-y-2">
                <span class="text-xs font-bold text-amber-600 uppercase tracking-widest">Hành Trình Đổi Mới</span>
                <h2 class="font-serif text-3xl font-bold text-brandBlue">Dấu Ấn Lịch Sử (1966 - 2026)</h2>
                <p class="text-xs sm:text-sm text-slate-600">Những mốc son chói lọi đánh dấu sự phát triển của Trường THPT Minh Hà</p>
            </div>

            <!-- Timeline items -->
            <div class="relative border-l-2 border-sky-300 ml-4 sm:ml-32 space-y-12">
                
                <!-- Timeline 1 -->
                <div class="relative pl-8 sm:pl-10 group">
                    <div class="absolute -left-[17px] top-0 w-8 h-8 rounded-full bg-white border-4 border-sky-400 flex items-center justify-center text-xs text-sky-600 shadow-md">
                        <i class="fa-solid fa-seedling"></i>
                    </div>
                    <div class="hidden sm:block absolute -left-28 top-0 text-sm font-bold text-brandBlue font-serif">1966</div>
                    <div class="glass-card p-6 rounded-2xl shadow-sm border border-sky-100 hover:shadow-md transition">
                        <span class="sm:hidden inline-block px-2.5 py-0.5 rounded bg-sky-100 text-sky-800 text-xs font-bold mb-2">Năm 1966</span>
                        <h3 class="font-serif font-bold text-lg text-brandBlue">Thành Lập Trong Gian Khó</h3>
                        <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
                            Trường cấp III Minh Hà chính thức được thành lập giữa những năm tháng chiến tranh chống Mỹ ác liệt, đáp ứng khát vọng học tập của con em nhân dân vùng đảo Quảng Yên.
                        </p>
                    </div>
                </div>

                <!-- Timeline 2 -->
                <div class="relative pl-8 sm:pl-10 group">
                    <div class="absolute -left-[17px] top-0 w-8 h-8 rounded-full bg-white border-4 border-amber-400 flex items-center justify-center text-xs text-amber-600 shadow-md">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>
                    <div class="hidden sm:block absolute -left-28 top-0 text-sm font-bold text-brandBlue font-serif">1990 - 2010</div>
                    <div class="glass-card p-6 rounded-2xl shadow-sm border border-amber-100 hover:shadow-md transition">
                        <span class="sm:hidden inline-block px-2.5 py-0.5 rounded bg-amber-100 text-amber-800 text-xs font-bold mb-2">1990 - 2010</span>
                        <h3 class="font-serif font-bold text-lg text-brandBlue">Xây Dựng & Kiên Cố Hóa</h3>
                        <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
                            Nhà trường từng bước hiện đại hóa cơ sở vật chất, xây dựng các dãy nhà cao tầng khang trang, phòng thí nghiệm đạt chuẩn và nâng cao chất lượng đội ngũ giáo viên.
                        </p>
                    </div>
                </div>

                <!-- Timeline 3 -->
                <div class="relative pl-8 sm:pl-10 group">
                    <div class="absolute -left-[17px] top-0 w-8 h-8 rounded-full bg-white border-4 border-rose-400 flex items-center justify-center text-xs text-rose-600 shadow-md">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <div class="hidden sm:block absolute -left-28 top-0 text-sm font-bold text-brandBlue font-serif">2026</div>
                    <div class="glass-card p-6 rounded-2xl shadow-sm border border-rose-100 hover:shadow-md transition bg-gradient-to-br from-white to-rose-50/50">
                        <span class="sm:hidden inline-block px-2.5 py-0.5 rounded bg-rose-100 text-rose-800 text-xs font-bold mb-2">Năm 2026</span>
                        <h3 class="font-serif font-bold text-lg text-brandBlue">Rạng Rỡ Mốc Son 60 Năm</h3>
                        <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
                            Trường THPT Minh Hà khẳng định vị thế là một trong những lá cờ đầu của giáo dục địa phương, vững bước tiến vào kỷ nguyên số với ngọn lửa tri thức không bao giờ tắt.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- SECTION 3: THƯ VIỆN ẢNH THANH XUÂN (GALLERY) -->
    <section id="thu-vien" class="py-20 bg-warmCream">
        <div class="max-w-6xl mx-auto px-4 sm:px-6">
            <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
                <span class="text-xs font-bold text-amber-600 uppercase tracking-widest">Ký Ức Đẹp</span>
                <h2 class="font-serif text-3xl font-bold text-brandBlue">Góc Thanh Xuân Minh Hà</h2>
                <p class="text-xs sm:text-sm text-slate-600">Những khoảnh khắc giản dị mà đong đầy cảm xúc học trò</p>
            </div>

            <!-- Image Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="group relative overflow-hidden rounded-2xl shadow-sm border border-rose-100 bg-white">
                    <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=800&auto=format&fit=crop" alt="Sân trường" class="w-full h-56 object-cover group-hover:scale-105 transition duration-500">
                    <div class="p-4 bg-white">
                        <span class="text-[10px] font-bold text-amber-600 uppercase">Khuôn Viên</span>
                        <h4 class="font-serif font-bold text-slate-800 text-sm">Góc sân trường ngợp nắng thu</h4>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="group relative overflow-hidden rounded-2xl shadow-sm border border-rose-100 bg-white">
                    <img src="https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=800&auto=format&fit=crop" alt="Lớp học" class="w-full h-56 object-cover group-hover:scale-105 transition duration-500">
                    <div class="p-4 bg-white">
                        <span class="text-[10px] font-bold text-sky-600 uppercase">Học Tập</span>
                        <h4 class="font-serif font-bold text-slate-800 text-sm">Giờ giảng bài hăng say</h4>
                    </div>
                </div>

                <!-- Card 3 -->
                <div class="group relative overflow-hidden rounded-2xl shadow-sm border border-rose-100 bg-white">
                    <img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=800&auto=format&fit=crop" alt="Hoạt động" class="w-full h-56 object-cover group-hover:scale-105 transition duration-500">
                    <div class="p-4 bg-white">
                        <span class="text-[10px] font-bold text-rose-600 uppercase">Ngoại Khóa</span>
                        <h4 class="font-serif font-bold text-slate-800 text-sm">Nụ cười tươi rạng rỡ tuổi 17</h4>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 4: INTERACTIVE MINIGAME QUIZ -->
    <section id="minigame" class="py-20 bg-gradient-to-b from-pastelRose/40 via-pastelSky/40 to-warmCream">
        <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="text-center max-w-xl mx-auto mb-10 space-y-2">
                <span class="text-xs font-bold text-amber-600 uppercase tracking-widest">Góc Tương Tác</span>
                <h2 class="font-serif text-3xl font-bold text-brandBlue">Thử Thách: Hành Trình 60 Năm</h2>
                <p class="text-xs sm:text-sm text-slate-600">Trả lời 5 câu hỏi nhanh để nhận **Tấm Vé Thanh Xuân** cá nhân hóa độc quyền!</p>
            </div>

            <!-- Quiz Game Box Container -->
            <div class="bg-white/90 rounded-3xl shadow-xl border-2 border-amber-200/80 p-6 sm:p-10 relative overflow-hidden backdrop-blur-md">
                
                <!-- Background decorative element -->
                <div class="absolute -right-12 -bottom-12 w-48 h-48 bg-rose-100/60 rounded-full blur-2xl pointer-events-none"></div>

                <!-- STEP 1: REGISTRATION -->
                <div id="quizWelcome" class="space-y-5">
                    <div class="text-center space-y-2">
                        <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center text-xl mx-auto">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>
                        <h3 class="font-serif font-bold text-xl text-brandBlue">Nhập Thông Tin Của Bạn</h3>
                        <p class="text-xs text-slate-500">Tên và lớp của bạn sẽ được in trực tiếp lên Tấm Vé Thanh Xuân kỷ niệm.</p>
                    </div>

                    <div class="space-y-3 max-w-md mx-auto">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Họ và tên:</label>
                            <input type="text" id="quizUserName" placeholder="Nguyễn Văn A" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-300">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Lớp / Niên khóa / Cựu HS:</label>
                            <input type="text" id="quizUserClass" placeholder="12A1 (Niên khóa 2023 - 2026)" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-300">
                        </div>
                    </div>

                    <button onclick="startQuizGame()" class="w-full max-w-md mx-auto block py-3 rounded-xl bg-gradient-to-r from-amber-400 to-rose-300 hover:from-amber-500 hover:to-rose-400 text-slate-900 font-bold text-sm tracking-wide shadow-md transition">
                        Bắt Đầu Giải Đố <i class="fa-solid fa-play ml-1"></i>
                    </button>
                </div>

                <!-- STEP 2: QUESTIONS -->
                <div id="quizQuestions" class="hidden space-y-6">
                    <div class="flex justify-between items-center text-xs font-bold text-slate-500 border-b border-slate-100 pb-3">
                        <span id="quizCounter" class="text-amber-600">Câu hỏi 1 / 5</span>
                        <span id="quizScore" class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full">Điểm: 0</span>
                    </div>

                    <h3 id="quizQuestionText" class="font-serif font-bold text-lg text-brandBlue min-h-[50px]">
                        Nội dung câu hỏi...
                    </h3>

                    <div id="quizOptions" class="space-y-2.5">
                        <!-- Options injected via JS -->
                    </div>

                    <div id="quizExplanation" class="hidden p-3.5 rounded-xl bg-sky-50 border border-sky-100 text-xs text-sky-800">
                        <span class="font-bold"><i class="fa-solid fa-lightbulb"></i> Bạn có biết: </span>
                        <span id="quizExplanationText"></span>
                    </div>

                    <button id="quizNextBtn" onclick="nextQuizQuestion()" class="hidden w-full py-3 rounded-xl bg-brandBlue text-white font-bold text-xs uppercase tracking-wider hover:bg-slate-800 transition">
                        Câu Hỏi Tiếp Theo <i class="fa-solid fa-chevron-right ml-1"></i>
                    </button>
                </div>

                <!-- STEP 3: TẤM VÉ THANH XUÂN RESULT -->
                <div id="quizResult" class="hidden space-y-6 text-center">
                    <div class="space-y-1">
                        <span class="inline-block px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full text-xs font-bold">Hoàn Thành Thử Thách!</span>
                        <h3 class="font-serif font-bold text-2xl text-brandBlue">Tấm Vé Thanh Xuân Dành Cho Bạn</h3>
                    </div>

                    <!-- TICKET DESIGN -->
                    <div id="youthTicketCard" class="bg-gradient-to-r from-warmCream via-rose-50 to-sky-50 border-2 border-amber-300 rounded-2xl p-6 shadow-lg text-left relative overflow-hidden max-w-lg mx-auto">
                        <!-- Ticket Punch Notches -->
                        <div class="absolute -left-3 top-1/2 -translate-y-1/2 w-6 h-6 bg-white rounded-full border-r-2 border-amber-300"></div>
